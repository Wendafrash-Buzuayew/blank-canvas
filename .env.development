# Backend API Gateway URL (Spring Cloud Gateway port 8081)
VITE_API_BASE_URL=/api

# Direct backend gateway override (if proxying through Vite is not desired)
# VITE_API_GATEWAY_URL=http://localhost:8081/api
# WebSocket (STOMP over SockJS) endpoint; defaults to same-origin /ws via the Vite proxy
# VITE_WS_URL=http://localhost:8081/ws
