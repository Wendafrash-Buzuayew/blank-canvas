# QRServe backend — required environment.
# Copy to `.env` (git-ignored) and fill in. Do NOT commit the filled copy.
#
# Every service now fails fast at startup if JWT_SECRET or QR_SIGNATURE_SECRET
# is unset. That is deliberate: the previous hardcoded defaults meant anyone
# could forge tokens and QR signatures.

# JWT signing key, shared by all services. Base64, >= 32 bytes decoded.
#   openssl rand -base64 48
# Rotating this invalidates every issued access AND refresh token — all users
# must log in again.
JWT_SECRET=

# HMAC key for QR payload signatures (tamper protection on public menu links).
#   openssl rand -base64 32
QR_SIGNATURE_SECRET=

# Set only during a secret rotation, to the value being retired. QR codes
# signed with it still validate; new codes are always signed with
# QR_SIGNATURE_SECRET. Clear it once every stand has been reprinted.
QR_SIGNATURE_SECRET_PREVIOUS=

# Public tenant base domain. Each merchant is served at
# {merchantSlug}.${PUBLIC_BASE_DOMAIN}. Every service fails to start without
# it, deliberately: a default would emit QR codes pointing at the wrong host,
# and that failure is discovered by a customer holding a phone.
#
# Local development: use a public wildcard that resolves to loopback, so
# tenant subdomains work with no /etc/hosts editing at all:
#   PUBLIC_BASE_DOMAIN=localtest.me:3000
#   PUBLIC_URL_SCHEME=http
PUBLIC_BASE_DOMAIN=
PUBLIC_URL_SCHEME=https

# Trace sampling rate. 1.0 = every request (expensive). Production should stay low.
TRACE_SAMPLE_RATE=0.1

# Gateway log verbosity. Raise to DEBUG/TRACE only while debugging routing —
# TRACE on the security logger prints token material.
GATEWAY_LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=INFO
NETTY_LOG_LEVEL=INFO
