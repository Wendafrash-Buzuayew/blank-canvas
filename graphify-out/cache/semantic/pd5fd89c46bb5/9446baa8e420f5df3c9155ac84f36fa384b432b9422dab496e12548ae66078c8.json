{"nodes": [{"id": "backend_readme_qrserve", "label": "QRServe Platform", "file_type": "concept", "source_file": "backend/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_readme_hexagonal_architecture", "label": "Hexagonal Architecture (Ports and Adapters)", "file_type": "concept", "source_file": "backend/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_readme_clean_architecture", "label": "Clean Architecture", "file_type": "concept", "source_file": "backend/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_readme_domain_driven_design", "label": "Domain-Driven Design (DDD)", "file_type": "concept", "source_file": "backend/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_readme_multi_tenant_rbac", "label": "Multi-Tenant Security & RBAC Roles", "file_type": "rationale", "source_file": "backend/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every DB record is tenant-partitioned via merchant_id; JwtAuthenticationFilter propagates merchantId into TenantContext ThreadLocal so tenant data isolation is enforced per-request."}, {"id": "backend_readme_websocket_channels", "label": "Real-Time WebSocket Channels (/ws/orders)", "file_type": "concept", "source_file": "backend/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_readme_tenant_subdomain_routing", "label": "Tenant Subdomains in Local Development", "file_type": "rationale", "source_file": "backend/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Subdomains do not resolve against localhost and per-tenant /etc/hosts edits get bypassed, so localtest.me/sslip.io wildcard-to-loopback DNS is used; vite.config.ts must set changeOrigin:false or the Host header (and thus the tenant label) is rewritten away before the gateway sees it, and server.allowedHosts must include .localtest.me because Vite 6 blocks unrecognised Host headers."}, {"id": "backend_readme_reserved_subdomains", "label": "Reserved Subdomains", "file_type": "rationale", "source_file": "backend/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "admin, api, app, www, static, assets, ws, mail, status never resolve as a tenant; an unresolvable label returns 404 rather than falling back to a default tenant, because on a wildcard domain a fallback would turn every mistyped subdomain into a cross-tenant read."}, {"id": "backend_readme_merchant_slug_immutability", "label": "Merchant Slugs Are Permanent", "file_type": "rationale", "source_file": "backend/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The slug is a hostname printed onto physical table stands, so PUT /api/merchants/{id} rejects renames; supporting renames would need an alias table for old hostnames, deliberately not built yet, and the rejection is what makes deferring that safe."}, {"id": "backend_readme_required_environment_variables", "label": "Required Environment Variables", "file_type": "rationale", "source_file": "backend/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JWT_SECRET, QR_SIGNATURE_SECRET and PUBLIC_BASE_DOMAIN have no defaults: a default JWT/QR secret lets anyone forge tokens/signatures, and a default base domain emits QR codes pointing at the wrong host, discovered by a customer rather than at deploy time."}, {"id": "backend_readme_qr_signature_secret_rotation", "label": "Rotating the QR Signing Secret", "file_type": "rationale", "source_file": "backend/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "QR codes are printed on physical table stands, so rotation must not invalidate them all at once: set QR_SIGNATURE_SECRET_PREVIOUS to the outgoing value, set QR_SIGNATURE_SECRET to the new value, deploy, reprint at leisure, then clear the previous value. The signing key is HMAC-SHA256(masterSecret, merchantId) so a compromise is confined to one restaurant."}, {"id": "backend_readme_tenant_isolation_ci_gate", "label": "Tenant Isolation Is a CI Gate (TenantIsolationIT)", "file_type": "rationale", "source_file": "backend/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "backend/merchant-service/src/test/java/com/qrserve/merchant/TenantIsolationIT.java seeds two merchants and asserts merchant A's credential cannot reach merchant B's data; in a shared deployment an isolation defect is one restaurant reading another's revenue, so new tenant-scoped endpoints belong in that test file."}, {"id": "backend_readme_kubernetes_deployment_section", "label": "Kubernetes Deployment (README section)", "file_type": "document", "source_file": "backend/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_readme_bonus_extensions_phase2", "label": "Bonus Extensions (Phase 2 Integrations)", "file_type": "concept", "source_file": "backend/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "backend_readme_qrserve", "target": "backend_readme_hexagonal_architecture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/README.md", "source_location": null, "weight": 1.0}, {"s