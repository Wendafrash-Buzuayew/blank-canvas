rcuitbreaker_config", "label": "resilience4j CircuitBreaker Config (per-route, not default-filters)", "file_type": "code", "source_file": "backend/api-gateway/src/main/resources/application.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "backend_api_gateway_src_main_resources_application_apigateway", "target": "backend_api_gateway_src_main_resources_application_authserviceroute", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/api-gateway/src/main/resources/application.yml", "source_location": null, "weight": 1.0}, {"source": "backend_api_gateway_src_main_resources_application_apigateway", "target": "backend_api_gateway_src_main_resources_application_orderservicepublicroute", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/api-gateway/src/main/resources/application.yml", "source_location": null, "weight": 1.0}, {"source": "backend_api_gateway_src_main_resources_application_apigateway", "target": "backend_api_gateway_src_main_resources_application_merchantserviceroute", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/api-gateway/src/main/resources/application.yml", "source_location": null, "weight": 1.0}, {"source": "backend_api_gateway_src_main_resources_application_apigateway", "target": "backend_api_gateway_src_main_resources_application_orderserviceroute", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/api-gateway/src/main/resources/application.yml", "source_location": null, "weight": 1.0}, {"source": "backend_api_gateway_src_main_resources_application_apigateway", "target": "backend_api_gateway_src_main_resources_application_menuserviceroute", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/api-gateway/src/main/r