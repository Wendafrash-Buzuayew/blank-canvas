{"nodes": [{"id": "backend_analytics_service_src_main_resources_application_analyticsservice", "label": "analytics-service (Spring Boot app config)", "file_type": "code", "source_file": "backend/analytics-service/src/main/resources/application.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_analytics_service_src_main_resources_application_publicmenuurl_requirement", "label": "PUBLIC_BASE_DOMAIN / PublicMenuUrl Required-Config Rationale", "file_type": "rationale", "source_file": "backend/analytics-service/src/main/resources/application.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PublicMenuUrl is a @Component in com.qrserve.shared.common, which every service component-scans; a default value would let a service start while emitting QR codes pointing at the wrong host. A wrong-but-plausible printed QR code is discovered by a customer holding a phone; a startup failure is discovered by whoever ran the deploy."}, {"id": "backend_analytics_service_src_main_resources_application_qrsignaturesecretrotation", "label": "QR Signature Secret Rotation (verify-only previous secret)", "file_type": "rationale", "source_file": "backend/analytics-service/src/main/resources/application.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "qr.signature-secret-previous is verify-only: set to the outgoing secret during rotation so already-printed QR codes keep validating; clear it once reprinting is done. Signing always uses signature-secret."}], "edges": [{"source": "backend_analytics_service_src_main_resources_application_analyticsservice", "target": "backend_analytics_service_src_main_resources_application_publicmenuurl_requirement", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/analytics-service/src/main/reso